# Server
PORT=3000
NODE_ENV=production

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_public_anon_key
# Needed for signing short-lived realtime tokens from your custom auth users.
# In Supabase Dashboard: Project Settings -> API -> JWT Secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Frontend URL (for CORS)
# Use your deployed frontend origin(s), comma-separated if multiple.
# Example: https://traceup.app,https://www.traceup.app
FRONTEND_URL=https://traceup.app

# Optional admin auto-seed (create only if user does not already exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
ADMIN_NAME=System Admin
ADMIN_DEPARTMENT=Administration
ADMIN_SECURITY_QUESTION=What is your employee ID?
ADMIN_SECURITY_ANSWER=change_this_answer

# Seed script users (seed.js and seed-mongo.js)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_this_password
SEED_ADMIN_NAME=System Admin
SEED_ADMIN_DEPARTMENT=Security Office
SEED_ADMIN_SECURITY_QUESTION=What city were you born in?
SEED_ADMIN_SECURITY_ANSWER=change_this_answer
SEED_STUDENT_EMAIL=student@example.com
SEED_STUDENT_PASSWORD=change_this_password
SEED_STUDENT_NAME=Student User
SEED_STUDENT_DEPARTMENT=Engineering
SEED_STUDENT_SECURITY_QUESTION=What was the name of your first pet?
SEED_STUDENT_SECURITY_ANSWER=change_this_answer
